        "darwin-x64": "@typescript/typescript-darwin-x64/lib/tsc",
        "linux-arm64": "@typescript/typescript-linux-arm64/lib/tsc",
        "linux-x64": "@typescript/typescript-linux-x64/lib/tsc",
        "win32-arm64": "@typescript/typescript-win32-arm64/lib/tsc.exe",
        "win32-x64": "@typescript/typescript-win32-x64/lib/tsc.exe"
      },
      "args": [],
      "plainOutput": ["--pretty", "false"],
      "fileList": {
        "args": ["--listFilesOnly"],
        "format": "list"
      },
      "threads": {
        "one": ["--singleThreaded"],
        "n": ["--checkers", "{n}"]
      },
      "role": "reference"
    },
