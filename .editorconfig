root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{sh,js}]
indent_style = tab

[*.{json,yml,md}]
indent_style = space
indent_size = 2

# Raw tool output and patches are kept byte for byte.
[{results/**,fixtures/patches/**}]
insert_final_newline = unset
trim_trailing_whitespace = unset
